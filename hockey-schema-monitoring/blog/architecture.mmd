    style SLV  fill:#f0f4f8,stroke:#2D3F55,stroke-width:2px,color:#1E2D40,font-weight:bold
    style MON  fill:#edf7f5,stroke:#1E7E6B,stroke-width:2px,color:#1E2D40,font-weight:bold
    style UC   fill:#f5f0ff,stroke:#5B3FA6,stroke-width:2px,color:#1E2D40,font-weight:bold
